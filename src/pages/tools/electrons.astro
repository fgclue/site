---
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Layout from "../../layout/Layout.astro";

export const title = "Electron Configuration Calculator";
export const description = "Calculates electron configurations for you";

import elements from "./elements.json";
---

<Layout title="Electron Configuration Calculator" description="Calculates electron configurations for you" metaTitle="Electron Configuration Calculator">
  <Navbar />
  <main class="w-screen px-8 md:w-2xl gap-4 flex flex-col md:px-2">
    <div id="periodic-table" class="grid grid-cols-18 grid-rows-9">
      {
        elements.map((element) => (
          <div
            title={element.name + " (A = " + element.mass + ")"}
            class={
              element.color +
              " " +
              (element.Z == 0 ? "invisible" : "visible") +
              " border aspect-square cursor-pointer text-center " +
              element.border
            }
            data-z={element.Z}
            id="element"
          >
            <h2 class="text-sm">{element.Z}</h2>
            <h1 class="text-xl">{element.symbol}</h1>
          </div>
        ))
      }
    </div>

    <input id="electrons" placeholder="e⁻" />
    <button class="btn" id="calculate">Calculate configuration</button>

    <h1 class="text-center text-2xl" id="output">...</h1>
  </main>
  <script defer is:inline>
    const electronInput = document.getElementById("electrons");
    const calculateButton = document.getElementById("calculate");
    const periodicTableElements = document.querySelectorAll("#element");
    const output = document.getElementById("output");

    function subscriptify(n) {
        return n.toString()
            .replace('0', '⁰')
            .replace('1', '¹')
            .replace('2', '²')
            .replace('3', '³')
            .replace('4', '⁴')
            .replace('5', '⁵')
            .replace('6', '⁶')
            .replace('7', '⁷')
            .replace('8', '⁸')
            .replace('9', '⁹')
    }

    function electronConfiguration(atomicNumber) {
      const orbitals = [
        ["1s", 2],
        ["2s", 2],
        ["2p", 6],
        ["3s", 2],
        ["3p", 6],
        ["4s", 2],
        ["3d", 10],
        ["4p", 6],
        ["5s", 2],
        ["4d", 10],
        ["5p", 6],
        ["6s", 2],
        ["4f", 14],
        ["5d", 10],
        ["6p", 6],
        ["7s", 2],
        ["5f", 14],
        ["6d", 10],
        ["7p", 6],
      ];

      let electrons = atomicNumber;
      const config = [];

      for (const [orbital, capacity] of orbitals) {
        if (electrons <= 0) break;

        const fill = Math.min(electrons, capacity);
        config.push([orbital, fill]);
        electrons -= fill;
      }

      const exceptions = {
        24: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s¹ 3d⁵",
        29: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s¹ 3d¹⁰",
        41: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s¹ 4d⁴",
        42: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s¹ 4d⁵",
        44: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s¹ 4d⁷",
        45: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s¹ 4d⁸",
        46: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 4d¹⁰",
        47: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s¹ 4d¹⁰",
        78: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s² 4d¹⁰ 5p⁶ 6s¹ 4f¹⁴ 5d⁹",
        79: "1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d¹⁰ 4p⁶ 5s² 4d¹⁰ 5p⁶ 6s¹ 4f¹⁴ 5d¹⁰",
      };

      if (exceptions[atomicNumber]) {
        return exceptions[atomicNumber];
      }

      return config.map(([orbital, count]) => `${orbital}${subscriptify(count)}`).join(" ");
    }

    function recalculateActions() {
      output.textContent = electronConfiguration(electronInput.value ?? 0);
    }

    Array.from(periodicTableElements).forEach((element) => {
        element.addEventListener("click", () => {
            electronInput.value = element.dataset.z
            recalculateActions()
        })
    })

    calculateButton.addEventListener("click", recalculateActions);
    electronInput.addEventListener("input", recalculateActions);
  </script>
  <Footer />
</Layout>
